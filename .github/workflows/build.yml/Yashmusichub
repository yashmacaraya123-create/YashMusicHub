name: Build APK
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -q Instrumentalizer.zip
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: 17 }
      - name: Add Rubber Band and model
        run: |
          rm -rf Instrumentalizer/app/src/main/cpp/rubberband
          git clone --depth 1 https://github.com/breakfastquay/rubberband Instrumentalizer/app/src/main/cpp/rubberband
          rm -f Instrumentalizer/app/src/main/assets/PUT_model.onnx_HERE.txt
          curl -fL -o Instrumentalizer/app/src/main/assets/model.onnx https://huggingface.co/ferrite-stems/htdemucs-onnx-dml/resolve/main/htdemucs-dml.onnx
      - uses: android-actions/setup-android@v3
      - run: sdkmanager "cmake;3.22.1" "ndk;26.1.10909125"
      - uses: gradle/actions/setup-gradle@v4
        with: { gradle-version: 8.7 }
      - working-directory: Instrumentalizer
        run: gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with: { name: Instrumentalizer-apk, path: Instrumentalizer/app/build/outputs/apk/debug/app-debug.apk }
